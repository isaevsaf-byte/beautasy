# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# secrets — Google Merchant Center OAuth (never commit)
merchant-center/credentials.json
merchant-center/token.json
merchant-center/*.log

# python
__pycache__/
*.pyc

# claude
.claude/worktrees/

# sanity studio runtime (generated by `sanity dev`)
.sanity/

# remotion video project (its own install and renders)
/video/node_modules
/video/out
